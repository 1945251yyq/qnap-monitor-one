# 必改
NAS_IP=192.168.1.100
QNAP_HOSTNAME=QNAP-NAS
SNMP_COMMUNITY=public
GF_SECURITY_ADMIN_PASSWORD=请改成强密码

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_DEFAULT_LANGUAGE=zh-Hans
GF_DATE_FORMATS_DEFAULT_TIMEZONE=Asia/Shanghai

# 数据保留和扫描
TZ=Asia/Shanghai
PROMETHEUS_RETENTION=30d
QNAP_DATA_VOLUME_NAME=
QNAP_SHARE_SCAN_INTERVAL=3600

# GPU/PCIe 版可选
QNAP_GPU_ENABLED=false
QNAP_PCIE_CACHE_ROOT=/tmp/qnap-pcie
QNAP_PCIE_INCLUDE_BDFS=
QNAP_PCIE_EXCLUDE_BDFS=
