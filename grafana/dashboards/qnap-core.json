          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "qnap_disk_inventory_capacity_bytes{job=\"qnap_host_exporter\"} or label_replace(label_replace(label_replace(sum(qnap_disk_inventory_capacity_bytes{job=\"qnap_host_exporter\"}), \"disk_id\", \"总计\", \"__name__\", \".*\"), \"disk_model\", \"全部物理硬盘\", \"disk_id\", \"总计\"), \"status\", \"summary\", \"disk_id\", \"总计\")",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "host": true,
              "instance": true,
              "job": true,
              "source": true,
              "agent_host": true,
              "index": true
