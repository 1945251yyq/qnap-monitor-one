    {
      "id": 31,
      "type": "table",
      "title": "硬盘信息与数据卷",
      "description": "每个硬盘槽位仅显示型号、容量和健康度。容器启动时识别一次硬盘清单，之后每天刷新一次健康状态；“总计”行为全部已安装物理硬盘标称容量之和。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
