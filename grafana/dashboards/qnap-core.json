              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "容量"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "健康度"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "健康",
                        "color": "blue"
                      },
                      "-4": {
                        "text": "状态未知",
                        "color": "yellow"
                      },
                      "-5": {
                        "text": "未安装",
                        "color": "gray"
                      },
                      "-6": {
                        "text": "异常",
                        "color": "red"
                      },
                      "-9": {
                        "text": "读写错误",
                        "color": "red"
                      },
                      "summary": {
                        "text": "容量合计",
                        "color": "gray"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(good|Good|GOOD|normal|Normal|NORMAL|ready|Ready|READY|ok|Ok|OK|healthy|Healthy|HEALTHY|正常|良好)$",
                      "result": {
                        "text": "健康",
                        "color": "blue"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*(warning|Warning|WARNING|degraded|Degraded|DEGRADED|rebuild|Rebuild|REBUILD|caution|Caution|CAUTION|警告|降级|重建).*",
                      "result": {
                        "text": "警告",
                        "color": "yellow"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*(error|Error|ERROR|failed|Failed|FAILED|failure|Failure|FAILURE|bad|Bad|BAD|critical|Critical|CRITICAL|异常|错误|失败).*",
                      "result": {
                        "text": "异常",
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^-?[1-9][0-9]*$",
                      "result": {
                        "text": "警告",
                        "color": "yellow"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "无数据",
                        "color": "gray"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": false,
        "sortBy": [
          {
            "displayName": "槽位",
            "desc": false
          }
        ],
        "footer": {
