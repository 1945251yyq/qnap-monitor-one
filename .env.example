# QNAP 项目和数据目录
QNAP_PROJECT_ROOT=/share/Container/qnap-monitoring
QNAP_DATA_ROOT=/share/Container/qnap-monitoring

# 现有 Docker Hub 仓库；IMAGE_TAG 可改为 2.0.0 等版本进行回滚
DOCKERHUB_NAMESPACE=ydxian
IMAGE_TAG=latest

# NAS 与 SNMP
NAS_IP=192.168.1.100
QNAP_HOSTNAME=QNAP-NAS
SNMP_COMMUNITY=change_me
QNAP_DATA_VOLUME_NAME=
QNAP_SHARE_SCAN_INTERVAL=3600
TZ=Asia/Shanghai

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_DEFAULT_LANGUAGE=zh-Hans
GF_DATE_FORMATS_DEFAULT_TIMEZONE=Asia/Shanghai

# PostgreSQL；GF_DATABASE_* 必须与 POSTGRES_* 保持一致
POSTGRES_DB=grafana
POSTGRES_USER=grafana
POSTGRES_PASSWORD=change_me
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=grafana
GF_DATABASE_PASSWORD=change_me

# 对外端口
GRAFANA_PORT=3300
PROMETHEUS_PORT=39090
QNAP_EXPORTER_PORT=39273
QNAP_HOST_EXPORTER_PORT=39274
QNAP_PCIE_EXPORTER_PORT=39275
QNAP_PROCESS_EXPORTER_PORT=39276

# Prometheus
PROMETHEUS_RETENTION=30d

# PCIe / GPU
QNAP_PCIE_CACHE_ROOT=/var/cache/qnap-pcie
QNAP_PCIE_INCLUDE_BDFS=
QNAP_PCIE_EXCLUDE_BDFS=

# 当前高负载进程
QNAP_PROCESS_PROC_ROOT=/host-proc
QNAP_PROCESS_PASSWD=/host-etc-config/passwd
QNAP_PROCESS_SAMPLE_INTERVAL=15
QNAP_PROCESS_TOP_N=15
QNAP_PROCESS_COMMAND_LIMIT=220

# 动态 Dashboard
QNAP_PCIE_METRICS_URL=http://qnap-pcie-exporter:9275/metrics
QNAP_DASHBOARD_REFRESH_SECONDS=60
