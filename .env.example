# NAS 地址及设备显示名
NAS_IP=192.168.1.100
QNAP_HOSTNAME=QNAP-NAS

# QTS / QuTS hero 控制台中启用 SNMP v2c 后填写
SNMP_COMMUNITY=public
SNMP_PORT=161

# 采集与本地历史
COLLECT_INTERVAL=10s
HISTORY_RETENTION=720h
PROCESS_TOP_N=15

# 扫描所有共享目录可能产生大量磁盘 I/O，因此默认关闭
SHARE_SIZE_SCAN=false
SHARE_SCAN_INTERVAL=1h

# 如自动识别不到某块扩展卡，可填写 BDF，多个用逗号分隔
# 示例：PCIE_INCLUDE_BDFS=0000:01:00.0,0000:02:00.0
PCIE_INCLUDE_BDFS=
PCIE_EXCLUDE_BDFS=
